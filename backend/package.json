{
  "name": "vaultpay-backend",
  "version": "1.0.0",
  "description": "Backend API and MySQL database for VaultPay Digital Banking & Transaction Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
