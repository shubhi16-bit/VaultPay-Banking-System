# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vaultpay_db
DB_CONNECTION_LIMIT=10

# JWT Authentication
JWT_SECRET=vaultpay_super_secure_jwt_secret_token_key_change_in_production
JWT_EXPIRES_IN=24h

# Security & CORS (Frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
